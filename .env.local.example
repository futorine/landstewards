# --- ENS (Sepolia) ---

# The team's actual registered name. Falls back to a placeholder if unset.
NEXT_PUBLIC_ENS_NAME=demo.passportkit.eth

# A public Sepolia RPC works for reads but can rate-limit under demo-day load.
# Prefer a dedicated endpoint (Alchemy/Infura/etc.) if you have one. Used
# server-side only, for the live read-back of the evidence record.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Only set this if reads start failing because viem's bundled Sepolia ENS
# addresses have gone stale. Check https://docs.ens.domains/learn/deployments
# first.
# ENS_UNIVERSAL_RESOLVER=

# --- Privy (embedded wallet that signs the ENS write) ---

# REQUIRED to enable the "Publish to ENS" button. Create a free app at
# https://dashboard.privy.io and paste its App ID here. Without it, the app
# still runs (Walrus upload works) but the on-chain publish is disabled.
#
# The embedded wallet Privy provisions on login must be authorized to write
# records for NEXT_PUBLIC_ENS_NAME — its owner/controller, or an account
# approved via the registry's setApprovalForAll / the resolver's approve().
# One-time pre-demo step: log in once, copy the embedded wallet address, and
# approve it on the name in the ENS Manager app.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Walrus (Sui testnet) ---
# Public defaults need no wallet or funds. Override only if you're
# running your own publisher/aggregator.
# WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# WALRUS_EPOCHS=5


VITE_PRIVY_APP_ID=cms0dskcg012u0cl9wbr52hgb
VITE_PRIVY_CLIENT_ID=client-WY6c1HRT9pytLfuvMo5pjLPoAXVZ6dQEMhUXk4bmoCh8j