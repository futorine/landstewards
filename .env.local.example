# Copy to .env.local and fill in. Only NEXT_PUBLIC_PRIVY_APP_ID is required
# for on-chain writes; everything else has a working default.

# --- ENS (Sepolia, ENSv2) ---

# The project name. Stewardship slots derive from it as slot-N.<this>.
# Create one at /admin — it registers the name and mints the slots — or point
# this at a name you already own. /admin prints the exact value to paste here
# once verification passes.
NEXT_PUBLIC_ENS_NAME=landstewards.eth

# A public Sepolia RPC works for reads but can rate-limit under demo load.
# Prefer a dedicated endpoint (Alchemy/Infura/etc.) if you have one.
# Server-side only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Only set this if reads start failing because viem's bundled Sepolia ENS
# addresses have gone stale. Note that docs.ens.domains has been observed
# listing decommissioned addresses — verify against the chain, not the docs.
# ENS_UNIVERSAL_RESOLVER=

# --- Privy (wallet that signs the ENS writes) ---

# REQUIRED for anything that writes on-chain: registering a project, minting
# slots, attesting a steward, and publishing evidence. Create a free app at
# https://dashboard.privy.io and paste its App ID here. Without it the app
# still runs and reads live from ENS; the write paths are disabled.
#
# The signing wallet must own the project name. The app prefers the Privy
# embedded wallet and falls back to an injected wallet (Brave/MetaMask), so
# connecting the wallet that already owns the name needs no approval step.
# Add http://localhost:3000 to the allowed origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional — binds the App ID to this specific app. Also from the dashboard.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# --- Walrus (Sui testnet) ---
# Public defaults need no wallet or funds. Override only if you're running
# your own publisher/aggregator.
# WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# WALRUS_EPOCHS=5
